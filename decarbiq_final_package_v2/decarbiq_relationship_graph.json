  "insights": {
    "tx_vs_ca_divergence": {
      "observation": "TX industrial electricity correlates +0.68 with gas, CA correlates -0.35",
      "explanation": "TX is market-driven (energy-only), CA is policy-driven (regulated)",
      "implication": "Gas price forecasts translate differently by region"
    },
    "shale_rggi_equivalence": {
      "observation": "Shale era and post-RGGI have identical coefficients (-1.30)",
      "explanation": "Both represent structural shifts that lowered gas prices",
      "implication": "Policy and technology can have equivalent price impacts"
    },
    "coal_retirement_paradox": {
      "observation": "Policies that lowered gas prices correlated with higher electricity prices",
      "explanation": "Coal retirement removed cheap baseload, infrastructure costs rose",
      "implication": "Fuel cost savings don't guarantee electricity price reductions"
    },
    "regional_passthrough": {
      "observation": "Gas price passthrough varies: PJM/ISO-NE ~0.8, ERCOT 0.21, CAISO 0.42",
      "explanation": "Market structure, fuel mix, and regulation affect transmission",
      "implication": "National gas price forecasts need regional translation"
    }
  }
}