    <div id="exportDataModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-md">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">What is the purpose of your download?</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info mt-3">
                        <i class="fa fa-info-circle pr-2" aria-hidden="true"></i><small>Please specify your reason for exporting data.</small>
                    </div>

                    <form id="frmAnonymousUser">
                        <input class="modalInput" id="modalDataSetId" type="hidden">
                        <input class="modalInput" id="fullExport" type="hidden">
                        <div class="form-group row">
                            <div class="col-sm-12 col-md-5">
                                <label for="cboDownloadReasonCode" class="col-form-label required">Download reason</label>
                            </div>
                            <div class="col-sm-12 col-md-7" >
                                <select class="form-control" id="cboDownloadReasonCode" name="downloadReasonCode">
                                    
                                        <option  value="RESEARCH">Research</option>
                                    
                                        <option  value="COMMERCIAL">Commercial</option>
                                    
                                        <option  value="CURIOSITY">Curiosity</option>
                                    
                                        <option  value="DATA_ANALYSIS">Data analysis</option>
                                    
                                        <option  value="STUDY">Study</option>
                                    
                                        
                                    
                                        <option  value="OTHER">Other</option>
                                    
                                </select>
                            </div>
                        </div>
                        <div id="reasonSpecDiv" class="form-group row" style="display: none">
                            <div class="col-sm-12 col-md-5">
                                <label for="txtDownloadReason" class="col-form-label required">Please specify</label>
                            </div>
                            <div class="col-sm-12 col-md-7">
                                <input type="text" class="form-control" id="txtDownloadReason" name="downloadReason"/>
                            </div>
                        </div>
                        <button type="button" id="submitModalForm" class="btn btn-primary btn-sm btn-success submit-btn">OK</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-dismiss="modal"><i class="fa fa-times pr-1" aria-hidden="true"></i>Cancel</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
