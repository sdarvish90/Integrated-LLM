    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function applyFilterFromHash() {
            const hash = window.location.hash;
    
            if (hash) {
                const allCards = document.querySelectorAll('.card-proyecto');
                const categoryFilter = document.querySelector(`.category-filters [data-category="${hash.substring(1)}"]`);
                const targetCard = document.querySelector(`.card-proyecto${hash}`);
    
                if (categoryFilter) {
                    // Activar la categoría seleccionada
                    const allFilters = document.querySelectorAll('.category-filters [data-category]');
                    allFilters.forEach(filter => filter.classList.remove('active'));
                    categoryFilter.classList.add('active');
    
                    // Mostrar solo las tarjetas que coincidan con la categoría seleccionada
                    allCards.forEach(card => {
                        const cardCategory = card.getAttribute('data-category');
                        if (cardCategory === hash.substring(1)) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                } else if (targetCard) {
                    // Ocultar todas las tarjetas y mostrar solo la correspondiente al hash
                    allCards.forEach(card => {
                        card.style.display = 'none';
                    });
                    targetCard.style.display = '';
                }
    
                // Ocultar el .subfilter
                const subfilter = document.querySelector('.subfilter');
                if (subfilter) {
                    subfilter.style.display = 'none';
                }
    
                // Esperar a que el DOM actualice la visibilidad y luego hacer scroll
                requestAnimationFrame(() => {
                    const oportunidadesSection = document.querySelector('#oportunidades');
                    if (oportunidadesSection) {
                        oportunidadesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }
        }
    
        function updateHashFromCategory(category) {
            // Actualizar el hash en la URL
            window.location.hash = category;
        }
    
        document.addEventListener('DOMContentLoaded', () => {
            applyFilterFromHash();
    
            // Agregar evento de clic a los botones de categoría
            const categoryButtons = document.querySelectorAll('.category-filters [data-category]');
            categoryButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const category = button.getAttribute('data-category');
                    updateHashFromCategory(category);
                });
            });
        });
    
        window.addEventListener('hashchange', applyFilterFromHash);
</script>
<script>
        function handleHashChange() {
            console.log('Hash cambiado o cargado.');
            const hash = window.location.hash;
            console.log('Hash actual:', hash);
    
            if (hash) {
                const categoryFilter = document.querySelector(`.category-filters [data-category="${hash.substring(1)}"]`);
    
                if (categoryFilter) {
                    console.log('Simulando clic en el filtro de categoría:', categoryFilter);
    
                    // Simular clic en el botón de categoría
                    categoryFilter.click();
                } else {
                    console.log('No se encontró un filtro para la categoría del hash:', hash);
                }
            } else {
                console.log('No hay hash en la URL.');
            }
        }
    
        document.addEventListener('DOMContentLoaded', handleHashChange);
        window.addEventListener('hashchange', handleHashChange);
    </script>
<script>
    function hideEmptyElements(container) {
        container.querySelectorAll('h2, p').forEach(element => {
            if (element.innerHTML.trim() === '&nbsp;' || element.innerHTML.trim() === '') {
                element.style.display = 'none';
            }
        });
    }

    const observer = new MutationObserver((mutationsList) => {
        for (const mutation of mutationsList) {
            if (mutation.type === 'childList') {
                document.querySelectorAll('.submitted-message').forEach(submittedMessage => {
                    if (!submittedMessage.dataset.processed) {
                        submittedMessage.dataset.processed = 'true';
                        hideEmptyElements(submittedMessage);
                        const innerObserver = new MutationObserver(() => {
                            hideEmptyElements(submittedMessage);
                        });
                        innerObserver.observe(submittedMessage, { childList: true, subtree: true });
                    }
                });
            }
        }
    });

    observer.observe(document.body, { childList: true, subtree: true });
</script>
    <!-- Generated by the HubSpot Template Builder - template version 1.03 -->

