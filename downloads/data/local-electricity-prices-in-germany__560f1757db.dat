            <strong class="download__title">
                Local electricity prices in Germany
            </strong>
        </a>
    
                    
                
                    <div class="download__description">
                        <p>How integrating grid realities into the electricity market saves costs</p>
                    </div>
                
            </li>
        

    



                        
                    
                    
