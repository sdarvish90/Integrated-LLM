                    </li>
                </ul>
            </article>

             <footer class="modal__footer">
                 <div class="modal__footer-content">
                     <div class="switch">
                         <input type="checkbox" id="saveColorScheme" name="saveColorScheme" value="saveColorScheme" class="switch__input" checked>
