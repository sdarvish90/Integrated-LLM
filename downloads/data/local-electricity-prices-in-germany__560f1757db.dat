                            <use xlink:href="#moon"/>
                        </svg>

                        <span>Dark</span>

                        <svg class="icon color-scheme-menu__toggle-check-icon" aria-hidden="true" focusable="false">
                            <use xlink:href="#checkmark"/>
                        </svg>
                    </span>
                        </button>
                    </li>

                    <li class="color-scheme-menu__item">
