<style>
/* Root wrapper for HubSpot embedded forms */
.hbspt-form form {
  position: relative;
  max-width: 460px;
  margin: 0 auto!important;
  font-family: inherit;
  font-size: 1rem;
  line-height: 1.4;
  text-align: center;
}

/* Remove default gaps */
.hbspt-form .hs-form-field,
.hbspt-form fieldset {
  margin: 0;
  padding: 0;
  border: 0;
  text-align: center;
}

/* Hide default labels */
.hbspt-form .hs-form-field label {
  display: none;
}

/* Wrap for email field */
.hbspt-form .hs_email .input {
  position: relative;
  margin: 0 auto;
}

/* Email input style */
.hbspt-form .hs-input[type="email"] {
  width: 100%;
  box-sizing: border-box;
  padding: 0.9rem 7.5rem 0.9rem 1.2rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background-color: rgba(255, 255, 255, 0.1);
  color: #fff;
  font-family: inherit;
  font-size: 0.95rem;
  outline: none;
  margin: 0 auto;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.hbspt-form .hs-input[type="email"]:focus {
  background-color: rgba(255, 255, 255, 0.1);
  border-color: #fff;
}

.hbspt-form .hs-input[type="email"]::placeholder {
  color: #fff;
}

/* Submit button inside input */
.hbspt-form .hs_submit {
  margin: 0 auto;
}

.hbspt-form .hs_submit .actions input[type="submit"] {
  position: absolute;
  top: 49px;
  right: 0.4rem;
  transform: translateY(-50%);
  padding: 0.55rem 1.4rem;
  height: auto;
  border: none;
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 400;
  font-family: inherit;
  cursor: pointer;
  background-color: rgba(255,255,255,0.25)!important;
  color: #ffffff!important;
  margin: 0 auto;
  transition: background-color 0.2s ease, transform 0.1s ease;
}

.hbspt-form .hs_submit .actions input[type="submit"]:hover {
  background-color: #ffffff!important;
  color: #111111!important;
}

.hbspt-form .hs_submit .actions input[type="submit"]:active {
  transform: translateY(-50%) scale(0.98);
}

/* Success / error messages */
.hbspt-form .hs-error-msgs,
.hbspt-form .submitted-message {
  margin-top: 0.5rem;
  font-size: 0.85rem;
  text-align: center;
  color: #fff;
	margin: 0 auto;
}

/* Consent text */
.hbspt-form .hs-richtext,
.hbspt-form .legal-consent-container {
  margin-top: 0.75rem;
  margin-bottom: 0.75rem;
  font-size: 0.8rem;
  line-height: 1.4;
  text-align: center;
  margin: 0 auto;
  color: rgba(255,255,255,0.5);
}

.hbspt-form .hs-richtext a {
  color: rgba(255,255,255,1);
    text-align: center;
}

ul.no-list.hs-error-msgs.inputs-list {
	list-style-type: none;
  margin-top: 0.75rem;
  padding-left: 0px;
    text-align: center;
}

.no-list.hs-error-msgs.inputs-list li {
	color: #fff;
    text-align: center;
}

.hs-field-desc {
	color: rgba(255,255,255,0.5);
  font-size: 0.75rem;
  margin-bottom: 0.5rem;
    text-align: center;
}

form .hs-form-stacked {
	margin: 0 auto;
}

