<script>
    $(document).ready(function () {

        $('[data-toggle="tooltip"]').tooltip();

        $('#loginPopover').popover({
            template: '<div class="popover  popoverLogin" role="tooltip"><div class="arrow"></div><div class="popover-content"></div></div>',
            html: true,
            content: function () {
                return $('#popover-content').html();
            }
        });

        $('#loginPopover').click(function (e) {
            e.stopPropagation();
        });

        $(document).click(function (e) {
            if (($('.popover').has(e.target).length == 0) || $(e.target).is('.close')) {
                $('#loginPopover').popover('hide');
            }
        });

        $('#statusDefinitionPopover, .legend-popover').popover({
            fallbackPlacements: [$('#statusDefinitionPopover, .legend-popover').data("bsPlacement")],
            html: true,
            sanitize: false,
            content: function () {
                return $(this.parentElement).find('#popover-content').html();
            }
        });

        $('#statusDefinitionPopover, .legend-popover').click(function (e) {
            e.stopPropagation();
        });

        $(document).click(function (e) {
            if (($('.popover').has(e.target).length == 0) || $(e.target).is('.close')) {
                $('#statusDefinitionPopover, .legend-popover').each(function () {
                    var popover = $(this).popover('hide').data('bs.popover');
                    //TODO ?
                    //popover.inState.click = false;
                    $(this).data('bs.popover', popover);
                });
            }
        });

        $('.dropdown-submenu a.submenu-toggle').on("click", function (e) {

            // Close all other submenus
            $(".dropdown-submenu .dropdown-menu").not($(this).next('.dropdown-menu')).hide();
            $(".submenu-toggle").not(this).children('.glyphicon').removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');

            // Show Menu
            $(this).children('.glyphicon').toggleClass("glyphicon-chevron-up glyphicon-chevron-down");
            e.stopPropagation();
            e.preventDefault();
        });

        $(".dropdown-toggle").on("click", function () {
            // Close all submenus
            $(".dropdown-submenu .dropdown-menu").hide();
            $(".submenu-toggle .glyphicon").removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
        });

        if ("ontouchstart" in document.documentElement) {
            $('html').addClass('touch');
        }

        // Init Resize
        var repeat = new Miso.Repeat(500);

        // Ensure any secure links after created after initial page load are secured
        var secureLinks = {
            name: "secureLinks", onEvent: function () {
                Miso.Secured.SecureLinks();
            }
        }

        repeat.RegisterEvent(secureLinks, false);

        // Add message handler for modals
        window.addEventListener("message", receiveMessage, false);

        function receiveMessage(event) {
            var name = event.data.name;

            if (name) {
                var height = event.data.data;
                var frame = $(".embed-responsive-item[name='" + name + "']");

                if (event.data.type === "height") {
                    frame.height(height);
                    frame.parent().css("padding-bottom", (height + 20) + "px");
                } else if (event.data.type === "scroll") {
                    document.documentElement.scrollTop = frame[0].offsetTop + event.data.data + 10;
                }
            }
        }

        //function placeFooter() {
        //    var minHeight = window.innerHeight - ($("header:eq(0)").height() + $("header:eq(1)").height() + $("footer").height() + 85);
        //    $("body > .body-container").css("min-height", minHeight);
        //}

        //placeFooter();

        //if (Model.CurrentMode != ExtendedContextMode.Edit)
        //{
        //    :$(window).resize(function () { placeFooter() });
        //}

        var loggedIn = false;

        if (loggedIn) {

            Miso.SessionTimeout.loggedIn = loggedIn;
            Miso.SessionTimeout.timeout = 60;
            Miso.SessionTimeout.startSession();

            (function (open) {

                XMLHttpRequest.prototype.open = function (method, url, async, user, pass) {

                    this.addEventListener("readystatechange", function () {
                        if (this.readyState === "complete") {
                            Miso.SessionTimeout.updateSession();
                        }
                    }, false);

                    open.call(this, method, url, async, user, pass);
                };

            })(XMLHttpRequest.prototype.open);
        }

    });

    // Init Miso Secured
    Miso.PageGuid.SetPageGuid("9c647ab3-0869-459b-ae3f-055498f6bacf");
    Miso.Secured();
    Miso.Secured.SetLoginStatus(false, "/account/login/?ReturnUrl=/markets-and-operations/settlements/ts-pricing/transmission-settlements-billing/");
