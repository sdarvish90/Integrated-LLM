                        <div class="article-header__content">
                            <h1 class="article-header__title">Power Technology Excellence Awards 2023: Nexans</h1>
                                                                                        
                                <p class="article-header__excerpt">Nexans is based in France and is a Category Award winner in the 2023 Power Technology Excellence Awards.</p>

                                                                <div class="article-meta">
                                 
                                                                                    
                                        <!--  .article-meta -->
                            </div>
                                                        
                                                
                            <!-- sarticle-actions start -->
                            <div class="gdm-article-actions">

    
    
        <div class="gdm-article-share">
            <span class="button-toggle transparent-with-border gdm-article-share__button">Share
                <ul class="gdm-article-share-list__container">

