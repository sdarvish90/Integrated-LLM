			  if( p1 != null && p2 !== null ) {
			  jQuery.ajax({
			  type: "POST",
			  url: "https://www.power-technology.com/wp-content/themes/goodlife-wp-B2B/target_modal.php",
			  dataType: "html",
			  data: { 
