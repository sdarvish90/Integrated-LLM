                    <li><a href="https://twitter.com/intent/tweet?text=Power+Technology+Excellence+Awards+2023%3A+Nexans%0a&url=https://www.power-technology.com/excellence-awards/featured-company/2023-nexans/&via=Power_OnlineMag" class="x-share" target="_blank">Share on X</a></li>

                    <li><a href="http://www.linkedin.com/shareArticle?mini=true&url=https://www.power-technology.com/excellence-awards/featured-company/2023-nexans/" class="linkedin-share" target="_blank">Share on Linkedin</a></li>

                    <li><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.power-technology.com/excellence-awards/featured-company/2023-nexans/" class="facebook-share" target="_blank">Share on Facebook</a></li>

