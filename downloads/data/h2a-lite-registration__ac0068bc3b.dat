<div >
    <div class="sfContentBlock sf-Long-text" ><h1>H2A-Lite: Hydrogen Analysis Lite Production Model Registration</h1><p class="lead">Before downloading the Hydrogen Analysis Lite Production ( <a href="/hydrogen/h2a-lite">H2A-Lite</a>) model, please provide the following information.</p></div>
</div>
<div data-sf-role="form-container">
    <input type="hidden" data-sf-role="form-id" value="e0d1b75d-3994-423b-a7f0-6dc3228a31b8" name="FormId" />
    <input type="hidden" data-sf-role="marketo-settings" value="{&quot;syncFormFieldsToLeadFields&quot;:false,&quot;doSpecificWebCalls&quot;:false}" name="MarketoSettings" />

<form action="/hydrogen/h2a-lite-registration?sf_cntrl_id=ctl00%24Contentplaceholder1%24C004" method="POST" name="defaultFormctl00$Contentplaceholder1$C004" enctype="multipart/form-data" role="form">
<div class="sf-fieldWrp" data-sf-role="text-field-container">
    <input data-sf-role="violation-restrictions" type="hidden" value='{"maxLength":"255", "minLength": "0"}' />
    <input data-sf-role="violation-messages" type="hidden" value='{"maxLength":"Name (Required) field must be less than 255 characters", "required": "Name (Required) field input is required", "invalid": "Entry is not valid!", "regularExpression": "Name (Required) field input is invalid"}' />
    <label for='Textbox-1'>Name (Required)</label>
    <input id='Textbox-1' data-sf-role="text-field-input" type="text" name="TextFieldController" value="" required="required" pattern=".{0,255}"  />


    <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
</div>


<div class="sf-fieldWrp" data-sf-role="text-field-container">
    <input data-sf-role="violation-restrictions" type="hidden" value='{"maxLength":"255", "minLength": "0"}' />
    <input data-sf-role="violation-messages" type="hidden" value='{"maxLength":"Email address (Required) field must be less than 255 characters", "required": "Email address (Required) field input is required", "invalid": "Entry is not valid!", "regularExpression": "Email address (Required) field input is invalid"}' />
    <label for='Textbox-2'>Email address (Required)</label>
    <input id='Textbox-2' data-sf-role="text-field-input" type="text" name="TextFieldController_2" value="" required="required" pattern=".{0,255}"  />


    <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
</div>



<div class="sf-fieldWrp sf-RadioButtons" data-sf-role="multiple-choice-field-container">
    <input type="hidden" data-sf-role="violation-messages" value='{ "required": "Company/organization type (Required) field input is required", "maxLength":"Company/organization type (Required) field must be less than 255 characters" }' />
    <strong>Company/organization type (Required)</strong>


        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="Academic" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                Academic
            </label>
        </div>
        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="Industry" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                Industry
            </label>
        </div>
        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="Federal" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                Federal
            </label>
        </div>
        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="State" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                State
            </label>
        </div>
        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="Lab" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                Lab
            </label>
        </div>
        <div>
            <label>

                <input type="radio" name="MultipleChoiceFieldController" value="Other" data-sf-role="multiple-choice-field-input"  required="required" pattern=".{0,255}"  />
                Other
            </label>
        </div>
        <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
</div>


<div class="sf-fieldWrp" data-sf-role="text-field-container">
    <input data-sf-role="violation-restrictions" type="hidden" value='{"maxLength":"255", "minLength": "0"}' />
    <input data-sf-role="violation-messages" type="hidden" value='{"maxLength":"If other, please specify field must be less than 255 characters", "required": "If other, please specify field input is required", "invalid": "Entry is not valid!", "regularExpression": "If other, please specify field input is invalid"}' />
    <label for='Textbox-3'>If other, please specify</label>
    <input id='Textbox-3' data-sf-role="text-field-input" type="text" name="TextFieldController_1" value="" pattern=".{0,255}"  />


    <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
</div>


<div class="sf-fieldWrp" data-sf-role="text-field-container">
    <input data-sf-role="violation-restrictions" type="hidden" value='{"maxLength":"255", "minLength": "0"}' />
    <input data-sf-role="violation-messages" type="hidden" value='{"maxLength":"Postal code (Required) field must be less than 255 characters", "required": "Postal code (Required) field input is required", "invalid": "Entry is not valid!", "regularExpression": "Postal code (Required) field input is invalid"}' />
    <label for='Textbox-4'>Postal code (Required)</label>
    <input id='Textbox-4' data-sf-role="text-field-input" type="text" name="TextFieldController_0" value="" required="required" pattern=".{0,255}"  />


    <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
</div>




<div data-sf-role="field-captcha-container" style="display:none;" class="sf-fieldWrp">
    <div>
        <img data-sf-role="captcha-image" src='/Frontend-Assembly/Telerik.Sitefinity.Frontend/assets/dist/img/dummy.jpg?package=Gov'/>
        <button data-sf-role="captcha-audio-btn" type="button">Read the code</button>
        <audio data-sf-role="captcha-audio" controls style="display:none" />
    </div>

    <a data-sf-role="captcha-refresh-button">New code</a>

    <div>
        <input data-sf-role="violation-messages" type="hidden" value='{"required": "Captcha field input is required"}' />
        <label for='Textbox-5'>Please type the code above</label>
        <input id='Textbox-5' type="text" data-sf-role="captcha-input" name="captcha-a" required='required'/>
        <p data-sf-role="error-message" role="alert" aria-live="assertive"></p>
    </div>

    <input type="hidden" data-sf-role="captcha-k" name="captcha-k" />

    <input type="hidden" data-sf-role="captcha-settings" value="/RestApi/captcha/" />
    <input type="hidden" data-sf-role="captcha-iam" value='Incorrect value for the captcha image' />
</div>


<div class="sf-fieldWrp">
    <button type="submit"  >Submit</button>
</div>


</form>
</div>

<script lang="javascript">

    var allLabels = document.querySelectorAll('form[role="form"] label');
    var boldFieldRoles = [
        'dropdown-list-field-container',
        'email-text-field-container',
        'text-field-container',
        'paragraph-text-field-container'
    ];

    allLabels.forEach((label) => {
        var parentRole = label.parentElement && label.parentElement.getAttribute('data-sf-role');
        if (boldFieldRoles.includes(parentRole)) {
            label.style.fontWeight = 700;
            label.style.color = "#222";
            return;
        }
        if (label.innerText.indexOf('(Required') >= 0) {
            label.style.fontWeight = 700;
            label.style.color = "#222";
        } else {
            if (label.innerHTML.indexOf('MultipleChoiceFieldController') < 0) {
                label.style.fontWeight = "normal";
                label.style.color = "#222";
            }
        }
    });

	var allStrongs = document.querySelectorAll('form[role="form"] strong');

	allStrongs.forEach((label) => {
        if (label.innerText.indexOf('(Required)') >= 0) {
            label.innerText = label.innerText.replace('(Required)', '');
            const span = document.createElement("span");
            span.classList.add("required");
			const node = document.createTextNode("(Required)");
            span.appendChild(node);

            label.appendChild(span);
        }

        if (label.innerText.indexOf('(Required if not a U.S. Citizen)') >= 0) {
            label.innerText = label.innerText.replace('(Required if not a U.S. Citizen)', '');
            const span = document.createElement("span");
            span.classList.add("required");
            const node = document.createTextNode("(Required if not a U.S. Citizen)");
            span.appendChild(node);

            label.appendChild(span);
        }
    });

    var captchaButton = document.querySelector('button[data-sf-role="captcha-audio-btn"');
    if (captchaButton) {
        captchaButton.innerHTML = "READ CODE";
    }
</script>
<div >
    <div class="sfContentBlock sf-Long-text" ><p class="mt-0">Your information will be used to provide email updates from NLR about new releases. The mailing list addresses are never sold, rented, or distributed in any way. We will keep your information for as long as you'd like to receive updates. <a href="/hydrogen/contacts">Contact us</a> to be removed from the database. For more information, review the NLR&nbsp;&nbsp;<a data-sf-ec-immutable="" href="/security.html">security and privacy policy</a>.</p></div>
</div>
