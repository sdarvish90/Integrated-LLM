iqueIdentifier":{"value":"Natural Gas"}}},{"id":"bba2b64a-8a9f-49a9-9a51-fc3b71b6ea4b","url":"/en/data/taxonomy-mappings/news-mapping/electricity","name":"Electricity","displayName":"Electricity","fields":{"UniqueIdentifier":{"value":"Electricity"}}},{"id":"fedb027c-c553-4ff5-9e0b-ab7a9e90bf09","url":"/en/data/taxonomy-mappings/news-mapping/emissions","name":"Emissions","displayName":"Emissions","fields":{"UniqueIdentifier":{"value":"Emissions"}}},{"id":"a51b53a8-442c-433f-91e0-a961192c4c5c","url":"/en/data/taxonomy-mappings/news-mapping/biomass","name":"Biomass","displayName":"Biomass","fields":{"UniqueIdentifier":{"value":"Biomass"}}},{"id":"a51955c2-4442-42d7-9ea5-30a248c37391","url":"/en/data/taxonomy-mappings/news-mapping/hydrogen","name":"Hydrogen","displayName":"Hydrogen","fields":{"UniqueIdentifier":{"value":"Hydrogen"}}}]}},{"id":"5d3cde69-4aaf-48bf-91d1-e9dc42b8f1f0","url":"/en/data/taxonomy/commodity/gas-and-power/natural-gas","name":"Natural Gas","displayName":"Natural Gas","fields":{"Title":{"value":"Natural Gas"},"AlternateMapping":[{"id":"b1a2e2b3-4953-4964-88da-e870797aab2b","url":"/en/data/taxonomy-mappings/news-mapping/natural-gas/shale-gas","name":"Shale Gas","displayName":"Shale Gas","fields":{"UniqueIdentifier":{"value":"Shale Gas"}}},{"id":"0f8a5cd0-b93b-48ed-8d75-ed55b4544c04","url":"/en/data/taxonomy-mappings/news-mapping/natural-gas/pipeline","name":"Pipeline","displayName":"Pipeline","fields":{"UniqueIdentifier":{"value":"Pipeline"}}},{"id":"391d736b-6dc3-4f06-b6ff-61e63c617f9e","url":"/en/data/taxonomy-mappings/news-mapping/natural-gas/biogas","name":"Biogas","displayName":"Biogas","fields":{"UniqueIdentifier":{"value":"Biogas"}}},{"id":"a2fcf861-dc27-443a-a3a0-36441f6b2772","url":"/en/data/taxonomy-mappings/news-mapping/natural-gas/biomethane","name":"Biomethane","displayName":"Biomethane","fields":{"UniqueIdentifier":{"value":"Biomethane"}}}]}}]},"tagLabel":{"jsonValue":{"value":"Market"}}}}}},{"uid":"f57c1d71-72d4-45c1-9732-3836663ebeaf","componentName":"ColumnText","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Argus European gas market view summer 2025/Page Data/insight page introduction and image","fields":{"data":{"datasource":{"anchorID":{"value":"overview"},"type":"ColumnText","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":""}},"panels":{"results":[{"type":"TextPanel","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":"\u003cp\u003eEurope is in for a challenging first summer without Russian gas transiting Ukraine. The continent needs far higher imports than in the previous two summers to fill its underground gas stores, which started April at their lowest since 2022. This means that Europe must attract flexible LNG cargoes, for which it may face stiff competition if northeast Asia has a hot summer. Not to mention, there is barely any market-based incentive to fill storage this summer, meaning that governments may have to intervene at some point to make sure that storage fills adequately to get through winter 2025-26.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe following whitepaper provides Argus'\u0026nbsp;view on the key questions for this summer, such as:\u003c/p\u003e\n\u003cul\u003e\n    \u003cli\u003eHow much will Europe have in storage by the start of winter, and will state intervention be needed to get there?\u003c/li\u003e\n    \u003cli\u003eHow will industrial demand shape up in a weak macroeconomic environment, and how far will\u0026nbsp;the renewables buildout weigh on power-sector gas use this summer?\u003c/li\u003e\n    \u003cli\u003eWill competition between Asia and Europe for flexible LNG cargoes be fierce?\u003c/li\u003e\n    \u003cli\u003eWhat is Norway's maximum production potential this summer?\u003c/li\u003e\n    \u003cli\u003eTo what extent will\u0026nbsp;Ukraine's strong restocking demand alter the European balance?\u003c/li\u003e\n\u003c/ul\u003e"}}},{"type":"TextPanel","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":"\u003cp style=\"text-align: center;\"\u003e\u003cimg alt=\"Aromatics January\" src=\"/-/media/project/argusmedia/mainsite/english/images/news-and-insights/market-insight-papers/european-gas-image.png?rev=dd48b9cda30941579b2b5eebd19608b2\u0026amp;hash=7679C6F0984663090F9AA0CBF3D3A8DD\" style=\"height: 555px; width: 500px;\" /\u003e\u003c/p\u003e"}}}]}}}}},{"uid":"c199fe75-7fe0-435d-8a0b-acd4bcb6bf8f","componentName":"GenericForm","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Argus European gas market view summer 2025/Page Data/insight page form","params":{"Theme":"Navy"},"fields":{"FormId":{"value":"39628"},"FormSubmissionLink":{"value":{"href":""}},"AnchorID":{"value":"paper"},"EnableSiteSearch":{"value":true},"Title":{"value":"Download the insight paper"},"Description":{"value":""}}},{"uid":"16ac448c-5472-4c4b-9fa4-06f74bc4272a","componentName":"ProductListing","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Argus European gas market view summer 2025/Page Data/insight page related products","params":{"Theme":"Grey"},"fields":{"ProductPages":[{"id":"81c19e53-7802-4233-b068-54d3e6807b24","url":"/en/solutions/products/argus-european-natural-gas","name":"Argus European Natural Gas","displayName":"Argus European Natural Gas","fields":{"Type":{"id":"a541adba-8189-4f7b-831f-efe4ac1b21a9","url":"/en/data/listing-types/listingtype/product","name":"Product","displayName":"Product","fields":{"Title":{"value":"Product"},"AlternateMapping":[],"UniqueIdentifier":{"value":""},"AnchorID":{"value":""},"EnableSiteSearch":{"value":true}}},"IsArticle":{"value":false},"MetaDescription":{"value":"Daily European gas prices, trends and analysis including key gas price indexes, and forecasts based on a robust and accurate methodology."},"MetaKeywords":{"value":"daily gas prices, European gas prices, natural gas news, natural ga