<script type="text/javascript">

var event = new Date();
var options = { month: 'long' };
console.log(event.toLocaleDateString('es-ES', options));
var mesActual = event.toLocaleDateString('es-ES', options);
function filtrarplanificacion(mes){
	$(".mes-planificado").hide();
	mesActual = mes;
  	$("#select_macrosector").val('');
   $("#select_tipoactividad").val('');
  $("#select_areageografica").val('');
  $("#select_subsector").val('');
  	$(`.${mes}`).show();
}

function searchformdata(){
  console.log('searchform ')
	var macrosector = $("#select_macrosector").val();
	var sector = $("#select_subsector").val();
	var tipoactividad = $("#select_tipoactividad").val();
	var areageografica = $("#select_areageografica").val();
	var frase = $("#frase").val().toLowerCase();
	//$(".mes-planificado").hide();
  	//$(`.${mesActual}`).show();
	//var elements = $(`.${mesActual}`);

	$(".mes-planificado").hide();
  	$(".mes-planificado").show();
  	$(".tab").removeClass("active");
	var elements = $('.mes-planificado');

	elements.show();
	 
	 if(frase!='') {
		console.log('frase ' + frase);
		$("#select_macrosector").val('');
		$("#select_tipoactividad").val('');
		$("#select_areageografica").val('');
		$("#select_subsector").val('');
		$(".mes-planificado").hide();
		$(`[data-title*="${frase}"]`).show();
		return;
		/*
		$(elements).filter(`[data-title!="${frase}"]`).hide();
		console.log('prev' + JSON.stringify(elements));
		elements = elements.filter(`[data-title*="${frase}"]`);
		console.log('prev' + JSON.stringify(elements));
		elements.show();*/
  }
  
 	if(macrosector!=''){
		$("#select_macrosector option").each(function(item)
			{
				console.log('item ' + jQuery(this).val() + ' ** ' + macrosector);
			$(`[data-macrosector~="${jQuery(this).val()}"]`).hide();
			});
			
			var elements = $(`[data-macrosector~="${macrosector}"]`).filter('.mes-planificado');
			//var elements = $(`[data-macrosector~="${macrosector}"]`).filter(`.${mesActual}`);
			elements.show();
	}
	if(tipoactividad!=''){
		$("#select_tipoactividad option").each(function(item)
			{
				console.log('tipoactividad ' + jQuery(this).val() + ' ** ' + tipoactividad);
				$(elements).filter(`[data-tipoactividad~="${jQuery(this).val()}"]`).hide();
			});
			
			elements = elements.filter(`[data-tipoactividad~="${tipoactividad}"]`);
			elements.show();
	}
	if(areageografica!=''){
		$("#select_areageografica option").each(function(item)
			{
				console.log('areageografica ' + jQuery(this).val() + ' ** ' + areageografica);
				
				$(elements).filter(`[data-areageografica~="${jQuery(this).val()}"]`).hide();
			});
			
			elements = elements.filter(`[data-areageografica~="${areageografica}"]`);
			elements.show();
	}
	if(sector!=''){
		$("#select_subsector option").each(function(item)
			{
				console.log('sector ' + jQuery(this).val() + ' ** ' + sector);
				
				$(elements).filter(`[data-sector~="${jQuery(this).val()}"]`).hide();
			});
			
			elements = elements.filter(`[data-sector~="${sector}"]`);
			elements.show();
	}/*
	if(frase!='') {
		console.log('frase ' + frase);
		$("#select_macrosector").val('');
		$("#select_tipoactividad").val('');
		$("#select_areageografica").val('');
		$("#select_subsector").val('');
		$(".mes-planificado").hide();
		$(`[data-title*="${frase}"]`).show();*/
		/*
		$(elements).filter(`[data-title!="${frase}"]`).hide();
		console.log('prev' + JSON.stringify(elements));
		elements = elements.filter(`[data-title*="${frase}"]`);
		console.log('prev' + JSON.stringify(elements));
		elements.show();
  }
	  */
}

filtrarplanificacion(mesActual);
$( document ).ready(function() {
$(`#tab-${mesActual}`).click();
  });
</script>
