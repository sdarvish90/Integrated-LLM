<script type="text/javascript">
vueinstance = new Vue({
    el: '#app-view',
    data: function () {
        return {
            loading: true,
            convocatorias:[],
			grupoconvocatorias:[],
			destacadas:[],
			ferias:[],
            mercados:[],
            macrosectores:[],
            tiposeventos:[],
            modalidades:[],
            estados:[],
            regiones:[],
            total:0,
            totalPages:0,
			currentPage:1,
			maxVisibleButtons:8,
		   buscador:{evento:'3b64cd32-41a7-44c0-b12f-3b703b09cc6d',
                    modalidad:'00000000-0000-0000-0000-000000000000',
                   macrosector:'00000000-0000-0000-0000-000000000000',
                   tipoevento:'00000000-0000-0000-0000-000000000000',
                   region:'00000000-0000-0000-0000-000000000000',
                   estado:'00000000-0000-0000-0000-000000000000',
                   buscar:'',
				   fecha:'octubre'}
        }
    },
    computed: {

    },
    filters: {
        currencydecimal: function (value) {
            return value.toFixed(2)
        }
    },
    mounted: function () {
		this.cargarFiltros();
        this.buscarConvocatorias(1);
		this.buscarFerias(1);
    },
    watch: {
      
    },
	computed: {
          	
	  },
    methods: {
		url:function(item){
			if(item.LinkDetalleAlternativo)
				return item.LinkDetalleAlternativo;
  			return `/actividades/detalle-actividades${item.ItemDefaultUrl}`;
		},
		urlConvocatoria:function(item){
			if(item.LinkDetalleAlternativo)
				return item.LinkDetalleAlternativo;
  			return `/convocatorias-2023/detalle${item.ItemDefaultUrl}`;
		},
        thumbnail:function(item){
			return item.ImagenCard[0].ThumbnailUrl.toString().replace('tmb-', 'tmb-news');
		},
		buscarConvocatorias:function(page){
            this.loading = true;
            this.currentPage = page;
            page--;
            page = page * 12;
			const empty = '00000000-0000-0000-0000-000000000000';
			let url = `/api/actividades/actividads?$filter=contains(Title,%27${this.buscador.buscar}%27)%20`;
			if(this.buscador.tipoevento!=empty)
				url+=`and%20tipodeevento/any(x:x%20eq%20${this.buscador.tipoevento})%20`;
			if(this.buscador.modalidad!=empty)
				url+=`and%20modalidad/any(x:x%20eq%20${this.buscador.modalidad})%20`;
			if(this.buscador.macrosector!=empty)
				url+=`and%20macrosector/any(x:x%20eq%20${this.buscador.macrosector})%20`;
			/*if(this.buscador.mercado!=empty)
				url+=`and%20mercado/any(x:x%20eq%20${this.buscador.mercado})%20`;
			if(this.buscador.region!=empty)
				url+=`and%20region/any(x:x%20eq%20${this.buscador.region})%20`;
			if(this.buscador.estado!=empty)
				url+=`and%20estadoconvocatoriaactividad/any(x:x%20eq%20${this.buscador.estado})%20`;*/
			url+=`&$select=Id,UrlName,Title,Bajada,macrosector,ImagenCard,mercado,FechaInicioEvento,FechaFinEvento,PublicationDate,FechaCierrePostulaciones,tipodeevento,tiposdeevento,modalidad,modalidades,LinkDetalleAlternativo,ItemDefaultUrl,region&$expand=ImagenCard,tiposdeevento,modalidades,region&$orderby=PublicationDate%20desc&$skip=${page}&$top=30&$count=true`;
			
				fetch(url).then((response) => {
					if (response.ok) {
					  return response.json();
					} else {
										 console.log('error');
					  throw new Error('Something went wrong');
					}
				  })
				.then((responseJson) => {
					this.loading = false;
					this.total = responseJson['@@odata.count'];
					this.convocatorias = responseJson.value.slice(2);
					this.grupoconvocatorias = this.splitToNChunks([...this.convocatorias], Math.ceil(this.convocatorias.length/4));
					this.destacadas = responseJson.value.slice(0,2);
					let pages = parseInt(this.total / 12);
					this.totalPages = (this.total % 12) == 0 ? pages : pages + 1
                              
			});
		},
		
		buscarFerias:function(page){
            this.loading = true;
            this.currentPage = page;
            page--;
            page = page * 12;
			const empty = '00000000-0000-0000-0000-000000000000';
			let url = `/api/ferias/ferias?$filter=contains(TextoFecha,%27${this.buscador.fecha}%27)%20`;
			/*if(this.buscador.evento!=empty)
				url+=`and%20tipodeevento/any(x:x%20eq%20${this.buscador.evento})%20`;
			if(this.buscador.modalidad!=empty)
				url+=`and%20modalidad/any(x:x%20eq%20${this.buscador.modalidad})%20`;
			if(this.buscador.macrosector!=empty)
				url+=`and%20macrosector/any(x:x%20eq%20${this.buscador.macrosector})%20`;
			if(this.buscador.mercado!=empty)
				url+=`and%20mercado/any(x:x%20eq%20${this.buscador.mercado})%20`;
			if(this.buscador.region!=empty)
				url+=`and%20region/any(x:x%20eq%20${this.buscador.region})%20`;
			if(this.buscador.estado!=empty)
				url+=`and%20estadoconvocatoriaactividad/any(x:x%20eq%20${this.buscador.estado})%20`;*/
			url+=`&$select=Id,UrlName,Title,FechaInicio,FechaTermino,TextoFecha,PublicationDate,paises,ciudades&$expand=ImagenCarrusel,paises,ciudades&$orderby=PublicationDate%20desc&$skip=${page}&$top=5&$count=true`;
			
				fetch(url).then((response) => {
					if (response.ok) {
					  return response.json();
					} else {
										 console.log('error');
					  throw new Error('Something went wrong');
					}
				  })
				.then((responseJson) => {
				  this.loading = false;
  				this.total = responseJson['@@odata.count'];
				this.ferias = responseJson.value;
      			let pages = parseInt(this.total / 12);
                    this.totalPages = (this.total % 12) == 0 ? pages : pages + 1
                              
			});
		},
		
		cargarFiltros:function(){
            this.loading = true;
			const url_mercado = '/api/news/flat-taxa?$filter=TaxonomyId eq cf25787b-7a54-44f3-8383-485061fe1fab&$select=Title,Id&$orderby=Title%20asc';
			const url_macrosector = '/api/news/flat-taxa?$filter=TaxonomyId eq 543861ac-2fcc-4abc-9105-ebf7fd9b6e0e&$select=Title,Id&$orderby=Title%20asc';
			const url_tipoevento = '/api/news/flat-taxa?$filter=TaxonomyId eq 951b740f-12ae-4688-a6ce-2eb1ed3b7bbb&$select=Title,Id&$orderby=Title%20asc';
			const url_modalidad = '/api/news/flat-taxa?$filter=TaxonomyId eq 34b2b1b9-9406-4d0d-ac86-ed8ac5a9fe57&$select=Title,Id&$orderby=Title%20asc';
			const url_estado = '/api/news/flat-taxa?$filter=TaxonomyId eq 4ca00e50-15c4-4abb-aedd-2717ef060945&$select=Title,Id&$orderby=Title%20asc';
			const url_region = '/api/news/flat-taxa?$filter=TaxonomyId eq 783ebdad-395e-46b5-bd1a-711a66e485d0&$select=Title,Id&$orderby=Title%20asc';
			fetch(url_mercado).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.mercados = responseJson.value;                            
			});
			fetch(url_macrosector).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.macrosectores = responseJson.value;                            
			});
			fetch(url_tipoevento).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.tiposeventos = responseJson.value;                            
			});
			fetch(url_modalidad).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.modalidades = responseJson.value;                            
			});
			fetch(url_estado).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.estados = responseJson.value;                            
			});
			fetch(url_region).then((response) => {
				return response.json();
			  })
			.then((responseJson) => {
				this.loading = false;
				this.regiones = responseJson.value;                            
			});
		},
		filtrarferias: function (mes) {
			this.buscador.fecha = mes;
			this.buscarFerias(1);
        },
        searchform: function (event) {

            var dateobj = new Date();
            var hoy = dateobj.toISOString();
			this.buscarConvocatorias(1);
        },
		splitToNChunks:function (array, n) {
			let result = [];
			for (let i = n; i > 0; i--) {
				result.push(array.splice(0, Math.ceil(array.length / i)));
			}
			return result;
		}

    }
});

</script>

<script type="text/javascript">
const tabsBox = document.querySelector(".tabs-box"),
allTabs = tabsBox.querySelectorAll(".tab"),
arrowIcons = document.querySelectorAll(".icon i");

let isDragging = false;

const handleIcons = (scrollVal) => {
    let maxScrollableWidth = tabsBox.scrollWidth - tabsBox.clientWidth;
    arrowIcons[0].parentElement.style.display = scrollVal <= 0 ? "none" : "flex";
    arrowIcons[1].parentElement.style.display = maxScrollableWidth - scrollVal <= 1 ? "none" : "flex";
}

arrowIcons.forEach(icon => {
    icon.addEventListener("click", () => {
        // if clicked icon is left, reduce 350 from tabsBox scrollLeft else add
        let scrollWidth = tabsBox.scrollLeft += icon.id === "left" ? -340 : 340;
        handleIcons(scrollWidth);
    });
});

allTabs.forEach(tab => {
    tab.addEventListener("click", () => {
        tabsBox.querySelector(".active").classList.remove("active");
        tab.classList.add("active");
    });
});

const dragging = (e) => {
    if(!isDragging) return;
    tabsBox.classList.add("dragging");
    tabsBox.scrollLeft -= e.movementX;
    handleIcons(tabsBox.scrollLeft)
}

const dragStop = () => {
    isDragging = false;
    tabsBox.classList.remove("dragging");
}

tabsBox.addEventListener("mousedown", () => isDragging = true);
tabsBox.addEventListener("mousemove", dragging);
document.addEventListener("mouseup", dragStop);

// var slideIndex = 1;
// showSlides(slideIndex);

// function plusSlides(n) {
//   showSlides(slideIndex += n);
// }

// function currentSlide(n) {
//   showSlides(slideIndex = n);
// }

// function showSlides(n) {
//   var i;
//   var slides = document.getElementsByClassName("mySlides");
//   var dots = document.getElementsByClassName("dot");
//   if (n > slides.length) {slideIndex = 1}
//     if (n < 1) {slideIndex = slides.length}
//     for (i = 0; i < slides.length; i++) {
//       slides[i].style.display = "none";
//     }
//     for (i = 0; i < dots.length; i++) {
//       dots[i].className = dots[i].className.replace(" active", "");
//     }
//   slides[slideIndex-1].style.display = "block";
//   dots[slideIndex-1].className += " active";
// }
</script>
