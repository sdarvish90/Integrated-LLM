	<script>
		var mq = window.matchMedia("(min-width: 1080px)");

if (mq.matches) {
var socialController = new ScrollMagic.Controller();

$(window).on('load', function () {
var duration = $('.main').height() - $('.insight-post__content').offset().top -($(window).height() / 2);
var scene = new ScrollMagic.Scene({triggerElement: ".insight-post__content", duration: duration}).setPin(".insight-post__social-content").addTo(socialController);

new ScrollMagic.Scene({triggerElement: ".insight-post__content", offset: '20px'}).setClassToggle(".insight-post__social-content", "insight-post__social-content--active") // add class toggle.addTo(socialController);
});
}

$(document).on('click', '.social-scrollup', function (event) {
event.preventDefault();

$('html, body').animate({
scrollTop: $('body').offset().top
}, 500);
});

$(function () {
var postUrl = 'https://rmi.org/insight/demand-side-drivers-of-steel-decarbonization-automotive-procurement-practices/';
var shareUrl = postUrl;

$.getJSON('http://share-count.appspot.com/?url=' + encodeURIComponent(shareUrl) + "&callback=?", function (data) {
shares = data.shares;
$(".count").each(function (index, el) {
service = $(el).parents(".share-btn").attr("data-service");
count = shares[service];
if (count > 1000) {
count = (count / 1000).toFixed(1);
if (count > 1000) 
count = (count / 1000).toFixed(1) + "M";
 else 
count = count + "k";



}
$(el).html(count);
});
});
});
	</script>
		
	</body>
</html>
