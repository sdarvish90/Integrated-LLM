	<!-- Label For Modules Data Page -->
	
	
	<div class="widget_1599580755675 sr-hero-01 sr-cover-parallax  prototype-no-background  ">
		
		
		<div class="sr-cover-image overlay-"></div>
		

		<div class="container">
			
			<div class="row">
				<div class="col-sm-8 offset-sm-2">
			
					<div class="col-12">
						<div class="sr-cover d-flex align-items-center  height-small">
							<div class="sr-cover-inner ">
								
								
								
								
                                    <div class="description">
                                        <div class="col-sm-12 col-md-6 texto-izquierdo"><h1 style="text-align: left; font-size: 36px; line-height: 1.15;"><span style="color: #0093b2;">InvestChile <br>Legal Report</span><span style="background-color: rgba(0, 0, 0, 0.3);"></span></h1>
<h3 style="text-align: left; font-size: 16px;"><span>We invite you to download our InvestChile Legal Report, a monthly newsletter that provides information about:</span></h3>
<div>- The latest laws published in the country.</div>
<div>- The bills currently being processed in Congress.</div>
<div>- The decrees and regulations issued by the government and autonomous agencies.</div>
<div>- Important jurisprudence on matters that may impact foreign investment in Chile.</div>
<br>
<p><a href="#form_header" rel="noopener"><img src="https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=251&amp;name=CTA_VENTURE.png" alt="CTA_LEGALREPORT" width="251" style="width: 251px;" srcset="https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=126&amp;name=CTA_VENTURE.png 126w, https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=251&amp;name=CTA_VENTURE.png 251w, https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=377&amp;name=CTA_VENTURE.png 377w, https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=502&amp;name=CTA_VENTURE.png 502w, https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=628&amp;name=CTA_VENTURE.png 628w, https://tools.investchile.gob.cl/hs-fs/hubfs/CTA_VENTURE.png?width=753&amp;name=CTA_VENTURE.png 753w" sizes="(max-width: 251px) 100vw, 251px"></a></p>
