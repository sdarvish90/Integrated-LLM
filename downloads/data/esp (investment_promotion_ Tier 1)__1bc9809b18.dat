<style>
    .covid-libro {
        width: 300px;
    }

    .wrap-insights-covid {
        max-width: 1200px;
        margin: 0 auto;
    }

    .wrap-insights-covid .img-insights-covid {
        float: left;
        width: 25%;
    }

    .wrap-insights-covid .img-insights-covid img {
        max-width: 100%;
    }

    .wrap-insights-covid .texto-insights-covid {
        width: 100%;
        padding-left: 50px;
    }

    .wrap-insights-covid .texto-insights-covid p {
        color: #3b3c43;
        float: left;
        margin-left: 30px;
        width: 50%;
    }

    .titulo-celeste-mediano {
        color: #009ac3;
        font-family: 'LatoWebBold';
        font-size: 32px;
        margin: 10px 0 20px 30px;
        float: left;
        max-width: 700px;
        font-style: italic;
    }

    .wrap-insights-covid .texto-insights-covid .titulo-celeste-mediano p {
        color: #009ac3;
        font-family: 'LatoWebBold';
        font-size: 27px;
        margin: 10px 0 20px 0;
        float: left;
        width: 100%;
        max-width: 700px;
        font-style: italic;
    }

    .titulo-chico {
        font-size: 15px;
        font-style: normal;
    }

    /*----LOGOS----*/

    .boxes-logos {
        padding: 0 60px;
    }

    .box-logos {
        text-align: center;
        padding: 0 40px;
        margin-bottom: 70px;
    }

    .box-logos .img-logos {
        margin: 0 auto 20px;
        max-width: 90%;
    }
	@media (min-width: 992px){
		.box-logos .img-logos img {
			width: 100%;
			max-width: 200px;
		}
	}

    .box-logos p {
        margin-top: 5px;
        margin-bottom: 35px;
        color: #3b3c43;
    }

    .box-logos p a {
        color: #3b3c43;
    }

    .box-logos .datos-logos {
        height: 140px;
    }

    /*---FIN LOGOS---*/



    /*----BANNERS----*/

    .boxes-banners {
        padding: 0 60px;
    }

    .box-banners {
        text-align: center;
        padding: 0 50px;
        margin-bottom: 70px;
    }

    .box-banners .img-banners {
        margin: 0 auto 20px;
        max-width: 150px;
    }

    .box-banners .img-banners img {
        width: 100%;
    }

    .box-banners p {
        margin-top: 5px;
        margin-bottom: 35px;
        color: #3b3c43;
        text-align: justify;
    }

    .box-banners p a {
        color: #3b3c43;
    }

    .box-banners .datos-banners a {
        color: #eb6751;
        font-weight: bold;
    }

    /*---FIN BANNERS---*/


    /*---STAYTUNED---*/
    .covid-staytuned-titulo {
        display: none;
    }

    .boxes-staytuned {
        padding: 0 60px;
    }

    .box-staytuned {
        text-align: center;
        padding: 0 50px;
        margin-bottom: 70px;
    }

    .circulo-staytuned {
        margin: 0 auto;
        margin-top: 30px;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        font-size: 30px;
        font-weight: bold;
        color: #fff;
        line-height: 80px;
        text-align: center;
        background-color: #00a0ba;
    }

    .box-staytuned .datos-staytuned {
        font-size: 20px;
        color: #fff;
        margin: 20px auto;
    }

    /*---FIN STAYTUNED---*/

    @media (max-width: 640px) {

        .header-covid h2 {
            font-size: 20px;
        }

        .titulo-naranja {
            font-size: 24px;
        }

        .testimonio-covid {
            padding: 0;
        }

        .covid-videos {
            padding: 0;
        }

        .covid-videos .wrap-interior {
            padding: 0 20px;
        }

        .covid-staytuned .wrap-interior {
            padding: 0 20px;
        }

        .wrap-insights-covid .texto-insights-covid {
            width: 100%;
            padding-left: 0;
        }

        .wrap-insights-covid .img-insights-covid {
