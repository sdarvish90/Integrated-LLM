}

.request .w-request {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    background: #fff;
    padding: 2.2rem
}

@media only screen and (max-width: 768px) {
    .request .w-request {
        padding:1.5rem
    }
}

@media only screen and (max-width: 640px) {
    .request .w-request {
        -webkit-box-orient:vertical;
        -webkit-box-direction: normal;
        -ms-flex-direction: column;
        flex-direction: column;
        margin: 0 -1rem
    }
}

.request .w-request figure {
    width: 40%;
    text-align: center
}

@media only screen and (max-width: 640px) {
    .request .w-request figure {
        margin-bottom:1rem;
        width: 80%
    }
}

.request .w-request figure img {
    width: 18.8rem;
    max-width: 100%
}

.request .w-request .texto {
    width: 60%
}

@media only screen and (max-width: 640px) {
    .request .w-request .texto {
        width:100%
    }
}

.request .w-request .texto h3 {
    margin: 0 0 1.7rem;
    font-size: 2rem;
    font-family: 'LatoWebHeavy';
    color: #01758E;
    letter-spacing: .1em
}

@media only screen and (max-width: 768px) {
    .request .w-request .texto h3 {
        font-size:1.6rem
    }
}

@media only screen and (max-width: 550px) {
    .request .w-request .texto h3 {
        font-size:1.4rem
    }
}

.request .w-request .texto p {
    font-size: 1.1rem;
    color: #707070;
    margin-bottom: 3rem
}

@media only screen and (max-width: 768px) {
    .request .w-request .texto p {
        font-size:.9rem
    }
}
.request,.cifras-logos {
    margin-top: 1rem;
    padding: .4rem 0 1.5rem
}
.request .btn {
    font-size: .9rem;
    line-height: 1;
    color: #fff;
    border: none;
    border-radius: .3rem;
    padding: .8rem 1.6rem .8rem !important;
    width: 8.3rem;
    text-align: center;
    -webkit-transition: all .5s ease;
    transition: all .5s ease;
    background: #EB6751;
    text-transform: uppercase;
    display: inline-block
}
.request .btn.large {
    width: 14.4rem;
    height: 2.5rem
}

.request .btn1 {
    width: 12rem!important;
    font-size: .8rem!important;
    text-align: center!important
}
	@media (max-width: 991px){
		.request .btn1 {
			margin-bottom: 20px;
		}
	}
.request .btn2 {
    width: 17rem!important;
    font-size: .8rem!important;
    text-align: center!important
}

.request .btn:hover {
    background: #e7472c;
    color: #fff;
}

.request .btn i {
    font-size: .9rem;
    margin-left: .5rem
}

.request .btn img {
    width: 1rem!important;
    height: auto;
    margin-left: .5rem
}

.request .btn.borde-azul {
    background: #fff0;
    color: #2D778F;
    border: 3px solid #2D778F
}

.request .btn.borde-azul:hover {
    background: #2D778F;
    color: #fff
}

.request .btn.borde-blanco {
    background: #fff0;
    color: #fff;
    border: 2px solid #fff
}

.request .btn.borde-blanco:hover {
    background: rgb(255 255 255 / .3);
    color: #fff
}

.request .btn.blanco {
    background: #fff;
    color: #2D778F
}

.request .btn.btn-descargar {
    background: #fff;
    color: #2D778F;
    border: 3px solid #2D778F;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    width: 12.7rem;
    max-width: 100%;
    font-size: .917rem;
    text-align: left;
    padding: .4rem .8rem;
    height: 2.7rem;
    line-height: 1
}

.request .btn.btn-descargar img {
    width: .85rem;
    height: auto;
    margin-right: .4rem
}

.request .btn.btn-descargar.tipo2 {
    font-size: .8rem;
    width: 16rem;
    padding: .3rem .5rem;
    line-height: 1.1
}

.request .btn.btn-descargar.tipo3 {
    font-size: .8rem;
    width: auto;
    max-width: 15.5rem;
    min-width: 12rem;
    padding: .3rem 1rem .3rem .5rem;
    line-height: 1.1
}

