										<div class="img-evento">
											<img class="lazy" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20427%20304'%3E%3C/svg%3E" data-src="https://www.investchile.gob.cl/wp-content/uploads/2018/08/write-593333-1920-1-e1534279450977.jpg" />
										</div>
