<script>
        jQuery(document).ready(function() {
            function activateTabFromHash() {
                const hash = window.location.hash;
                const tabMapping = {
                    '#es': ['#espanol-tab-pane', '#espanol-tab-pane-2'],
                    '#en': ['#english-tab-pane', '#english-tab-pane-2'],
                    '#pt': ['#portugues-tab-pane', '#portugues-tab-pane-2'],
                    '#zh': ['#chino-tab-pane', '#chino-tab-pane-2'],
                    '#ja': ['#japones-tab-pane', '#japones-tab-pane-2'],
                    '#it': ['#italiano-tab-pane', '#italiano-tab-pane-2']
                };

                if (tabMapping[hash]) {
                    const tabIds = tabMapping[hash];

                    // Desactivar todos los tabs y contenidos
                    jQuery('.tab-pane').removeClass('active show');
                    jQuery('.nav-link').removeClass('active');

                    // Activar los tabs correspondientes
                    tabIds.forEach(function(tabPaneId) {
                        jQuery(tabPaneId).addClass('active show'); // Activar el contenido del tab
                        jQuery(`[href="${tabPaneId}"]`).addClass('active'); // Activar el botón del tab
                    });
                }
            }

            function handleSingleLanguage() {
                // Contar cuántos idiomas hay (por los tabs del selector)
                const languageButtons = jQuery('#myTab .dropdown-item').length;

                if (languageButtons === 1) {
                    // Ocultar solo el dropdown
                    jQuery('.language-selector .dropdown').hide();

                    // Mostrar el botón de scroll
                    jQuery('.scroll-to-form').show();

                    // Obtener el primer tab del form y activarlo
                    const firstFormTab = jQuery('.tab-content:not(.second) .tab-pane').first();
                    if (firstFormTab.length) {
                        jQuery('.tab-pane').removeClass('active show');
                        firstFormTab.addClass('active show');

                        // También activar el selector tab (si existe)
                        const selectorTab = jQuery('.tab-content.second .tab-pane').first();
                        if (selectorTab.length) {
                            selectorTab.addClass('active show');
                        }
                    }
                }
            }
            
            function handleLanguageSwitch() {
                // Al cambiar de tab, mostrar el botón del idioma correcto
                jQuery('#myTab').on('click', 'a', function() {
                    const targetPane = jQuery(this).attr('data-bs-target');
                    const idioma = jQuery(this).attr('aria-controls').replace('-tab-pane', '');
                    
                    // Ocultar todos los botones
                    jQuery('.scroll-to-form').hide();
                    
                    // Mostrar el botón del idioma actual
                    jQuery(`.scroll-btn-${idioma}`).show();
                });
            }
            function setupScrollButton() {
                jQuery('.scroll-to-form').on('click', function() {
                    const element = document.querySelector('.guia-form');
                    if (element) {
                        element.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            }
          
          function updateButtonText() {
                const translations = {
                    'espanol': 'Descargar',
                    'english': 'Download',
                    'portugues': 'Baixar',
                    'chino': '获得',
                    'japones': 'ダウンロード',
                    'italiano': 'Scarica'
                };

                jQuery('#myTab a').on('click', function() {
                    const idioma = jQuery(this).attr('aria-controls').replace('-tab-pane', '');
                    const text = translations[idioma] || 'Descargar';
                    jQuery('.scroll-to-form').text(text);
                });

                // Al cargar, establece el texto del primer idioma
                const firstIdioma = jQuery('#myTab a').first().attr('aria-controls').replace('-tab-pane', '');
                const firstText = translations[firstIdioma] || 'Descargar';
                jQuery('.scroll-to-form').text(firstText);
            }

            // Ejecutar la función al cargar la página
            activateTabFromHash();
            handleSingleLanguage();
            setupScrollButton();
          updateButtonText();

            // Cambiar el tab si el hash cambia
            jQuery(window).on('hashchange', function() {
                activateTabFromHash();
            });
        });
    </script>
