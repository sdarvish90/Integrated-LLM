})(window,document,'script','dataLayer','GTM-WSQXMHWJ');</script> <!-- End Google Tag Manager for WordPress by gtm4wp.com --> <script type="text/javascript">var ajaxurl = 'https://ammoniaenergy.org/wp-admin/admin-ajax.php';</script> <link rel="icon" href="https://ammoniaenergy.org/wp-content/uploads/2019/11/cropped-Artboard-6-e1573502614517-1.png" sizes="32x32" /><link rel="icon" href="https://ammoniaenergy.org/wp-content/uploads/2019/11/cropped-Artboard-6-e1573502614517-1.png" sizes="192x192" /><link rel="apple-touch-icon" href="https://ammoniaenergy.org/wp-content/uploads/2019/11/cropped-Artboard-6-e1573502614517-1.png" /><meta name="msapplication-TileImage" content="https://ammoniaenergy.org/wp-content/uploads/2019/11/cropped-Artboard-6-e1573502614517-1.png" /><style type="text/css" id="wp-custom-css">.sink_dropdown li ul {
    position: absolute;
    display: block;
    height: 0;
    max-height: 0;
    overflow: hidden;
    background: rgba(0, 0, 0, .5);
}

ul.sink_dropdown {
    list-style: none;
    position: relative;
    margin: 0;
}

.sink_dropdown {
    flex-wrap: nowrap;
}

.sink_dropdown a {
    padding: 10px;
	 text-decoration: none;
    color: #000;
    display: block;
}

.sink_dropdown li li a {
    display: block;
    position: relative;
    z-index: 100;
}

ul.sink_dropdown > li.menu-item-has-children > a:after {
    content: ' ▼';
    font-size: 6px;
    margin-left: 5px;
    vertical-align: middle;
}

.sink_dropdown li {
    position: relative;
}

.sink_dropdown > li {
    float: left;
    z-index: 200;
    height: auto;
}

.sink_dropdown li ul li {
    display: block;
    margin: 0;
}


.sink_dropdown > li.hover ul.sub-menu.has-subsub-menu {
    overflow: visible;
}

.sink_dropdown > li.hover > ul {
    visibility: visible;
    height: auto;
    max-height: 500px;
    -webkit-transition: height 1s ease;
    transition: all 1s ease;
}

@media only screen and (max-width: 767px) {

    .sink_dropdown > li {
        float: none;
        height: inherit;
    }
	
	    .sink_dropdown > li.hover > ul, .sink_dropdown li li.hover ul {
        position: static;
        transform: translateY(0px);
    }

	

	    ul#menu-primary-menu li {
        list-style: none;
        margin-left: 0;
        margin-bottom: .5em;
    }
	
		#btnControl:checked+.add-heat ul#menu-primary-menu {
        display: block;
        background: #fff;
        position: absolute;
        padding: 1em;
        z-index: 999;
        left: 0;
        right: 0;
    }
	
	.sink_dropdown > li > a {
        display: block;
        height: inherit;
    }
}



