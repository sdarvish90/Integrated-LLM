                    <li><a href="http://www.linkedin.com/shareArticle?mini=true&url=https://www.power-technology.com/excellence-awards/featured-company/2023-carbon-kapture/" class="linkedin-share" target="_blank">Share on Linkedin</a></li>

                    <li><a href="https://www.facebook.com/sharer/sharer.php?u=https://www.power-technology.com/excellence-awards/featured-company/2023-carbon-kapture/" class="facebook-share" target="_blank">Share on Facebook</a></li>

