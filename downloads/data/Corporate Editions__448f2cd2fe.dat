                            <div class="archive-title archive-title-featured">
                                <h4>From the Magazine</h4>
                            </div>
                        

                        
                            
                                <div id="content" class="content" role="main" itemprop="mainContentOfPage">

                                    <h1 class="entry-title" itemprop="headline">Huawei Corporate Edition 2023</h1>

                                    <div class="entry-byline">
                                                                                    <div class="article-lead-text"><p>pv magazine has once again partnered with solar manufacturing giant Huawei on a special Corporate Edition. Released in September 2023, the publication follows on the successful launch of the FusionSolar brand at Intersolar 2023 and coincides with Huawei&#8217;s partner summit.</p>
</div>
                                                                                                                        
                                                                                            <span class="entry-issue">
                                                    <a href="https://www.pv-magazine.com/issue/huawei-special-edition-2023/">
                                                       Issue Huawei Special Edition 2023                                                    </a>
                                                </span>
                                                                                    
                                                                                
                                        <time class="entry-published updated" datetime="2023-09-25T07:00:36+02:00" itemprop="datePublished" title="Monday, September 25, 2023, 7:00 am">September 25, 2023</time>
                                                                                    <span class="entry-author" itemprop="author" itemscope="itemscope" itemtype="http://schema.org/Person"><a href="https://www.pv-magazine.com/author/pvmagazinepartners/" title="Posts by pv magazine partners" rel="author" class="url fn n" itemprop="url"><span itemprop="name">pv magazine partners</span></a></span>
                        
                                                                                
                                        
                                    </div><!-- .entry-byline -->
                                    
                                                                        

