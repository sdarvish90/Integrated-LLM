            <div
        id="page-wrapper" class="flex flex-col min-h-screen "
        x-data="{
            isHome: '',
            selectedSubMobile: null,
            selectedSubDesktop: null,
            menuActive: false,
            searchActive: false,
            menuOpen: false,
            query: '',
            scrolledValue: 15,
            scrolled: false,
            headerHeight: 360,
            showNewsletterForm: true
        }"
        x-init="
            headerHeight = $refs.header.offsetHeight
            window.addEventListener('load', (event) => {
                if ($refs.homeheader) {
                    scrolledValue = $refs.homeheader.offsetHeight
                }
            });
            $watch('menuActive', () => {
                scrolled = window.pageYOffset > scrolledValue
                if (scrolled && $refs.homeheader) {
                    $refs.homeheader.style.display = 'none'
                }
            })
            $watch('searchActive', () => {
                scrolled = window.pageYOffset > scrolledValue
                if (scrolled && $refs.homeheader) {
                    $refs.homeheader.style.display = 'none'
                }
            })
        "
        @keydown.escape.window="searchActive ? [searchActive = false, query = ''] : ''; menuActive ? menuActive = false : ''; menuOpen ? menuOpen = false : ''"
        @scroll.window="
            scrolled = window.pageYOffset > scrolledValue
        "
    >
    



    
