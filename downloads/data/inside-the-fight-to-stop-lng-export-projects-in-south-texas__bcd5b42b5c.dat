    <li class=" menu-item" x-on:focusin="selectedSubDesktop = null">
        <a
            class="inline-flex gap-2 items-center font-serif tracking-widest group text-xs text-black/60"
            href="https://www.canarymedia.com/subscribe-to-our-newsletters"
                                    data-click-item="navigation link"
            data-element-location="header navigation link"
                            @mouseover="document.activeElement.blur(); menuOpen = false; searchActive = false"
                    >
            <span class="transition-colors text-decoration-transparent decoration-2 underline-offset-4 group-hover:text-decoration-black group-focus:text-decoration-black">Newsletters</span>
                            <svg class="relative top-px" width="10" height="5" viewBox="0 0 10 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path opacity="0.5" d="M1.5 1L5 4L8.5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                    </a>
                    <div
                class="hidden absolute left-1/2 top-full w-screen border-b translate-x-[-50vw] text-black bg-white border-black/10 shadow-menulight"
            >
                <div class="relative px-3.5 mx-auto h-full md:px-5 lg:flex lg:flex-col 2xl:px-32 max-w-screen-3xl">
                                                                                <div
                                    class="pt-7 pb-8 mt-2 border-t border-black/20"
                                    x-data="{
                                        selected: 1,
                                        newsletters: [],
                                        open: false,
                                    }"
                                    @header-count-changed.window="selected = $event.detail"
                                >
                                    <h2 class="mb-7 text-5xl type-gamma">Subscribe to Canary Media newsletters</h2>
                                    <div
                                        class="navigation-form"
                                        @click="() => {
                                            if ($event.target.classList.contains('hs-input') && $event.target.getAttribute('type') == 'checkbox') {
                                                if (newsletters.includes($event.target.getAttribute('name'))) {
                                                    newsletters = newsletters.filter(i => i !== $event.target.getAttribute('name'))
                                                } else {
                                                    newsletters.push($event.target.getAttribute('name'))
                                                }
                                                selected = $event.target.checked ? selected + 1 : selected - 1
                                            }
                                        }"
                                    >
                                        <div class="float-right pl-5 w-1/4 h-0 font-bold text-black">
                                            <span class="font-normal text-gray-400">You selected</span>
                                            <span x-text="selected">1</span>
                                            newsletter<span x-show="!selected || selected > 1">s</span>
                                        </div>
                                        <script charset="utf-8" type="8ae8faec00ab76ee1609d50e-text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
                                        <script type="8ae8faec00ab76ee1609d50e-text/javascript">
                                        const formContents = [
                                                                                                                                            {
                                                    class: ".hs-subscribe_to_the_newsletter",
                                                    html: `
                                                        <p>Canary articles and top energy news, on weekdays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-weekly_newsletter_subcription",
                                                    html: `
                                                        <p>News highlights and analysis, on Fridays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-northeast_energy_digest",
                                                    html: `
                                                        <p>Roundup of regional headlines, on weekdays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-southeast_energy_digest",
                                                    html: `
                                                        <p>Roundup of regional headlines, on weekdays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-midwest_energy_digest",
                                                    html: `
                                                        <p>Roundup of regional headlines, on weekdays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-western_energy_digest",
                                                    html: `
                                                        <p>Roundup of regional headlines, on weekdays</p>
                                                    `,
                                                },
                                                                                                                                            {
                                                    class: ".hs-ohio_utility_watch",
                                                    html: `
                                                        <p></p>
                                                    `,
                                                },
                                                                                    ]
                                        hbspt.forms.create({
                                            portalId: "19545844",
                                            formId: "480b0503-4171-42c6-a8a1-03f689bdea2c",
                                            onFormReady: function ($form) {
                                                let inputs = [...$form.querySelectorAll('input[type="checkbox"]')];
                                                window.dispatchEvent(new CustomEvent('header-count-changed', { detail: inputs.filter(i => i.checked).length }));
                                                window.subscribedCount = inputs.filter(i => i.checked).length;
                                                formContents.forEach(item => {
                                                    let div = document.createElement("div");
                                                    div.innerHTML = item.html;
                                                    $form.querySelector(item.class).append(div);
                                                });
                                                $form.querySelector('.hs-input[type="email"]').setAttribute('placeholder', 'Your email address');
                                            },
                                        });
                                        </script>
                                    </div>
                                </div>
                            
                            
                                                    
                </div>
            </div>
            </li>

                                            
                        
                                
                
        
            
