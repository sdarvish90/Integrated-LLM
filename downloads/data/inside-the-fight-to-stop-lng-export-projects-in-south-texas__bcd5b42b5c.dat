                <div class="flex-1"></div>
                

<div  class="w-full mx-auto max-w-screen-3xl box-border px-3.5 md:px-5 2xl:px-32">
	                        <p class="mb-4 text-base md:text-xl xl:text-3xl 2xl:pt-16">
                            <time class="font-bold" datetime="2024-02-28">28 February 2024</time>
                        </p>
                        <h1 class="font-serif text-8xl font-bold leading-tightest sm:text-12xl xl:text-15xl">Inside the fight to stop LNG export projects in South Texas</h1>
                    </div>
                <div class="flex-1">
                    

<div  class="w-full mx-auto max-w-screen-3xl box-border px-3.5 md:px-5 2xl:px-32">
	                        </div>
                </div>
            </div>
            <div class="absolute inset-x-0 top-[34%] h-[66%] bg-gradient-to-t from-black z-10"></div>
        </div>
    </div>

        
<section class="my-8 md:my-12">
    

<div  class="w-full mx-auto max-w-screen-3xl box-border px-3.5 md:px-5 2xl:px-32">
	                    <div class="md:grid md:grid-cols-12 md:gap-4">
