    p {
        line-height: 3.1rem;
    }

    .pagination {
        color: #000;
    }

    .filtros {
        color: #000;
    }

    .search-tools {
        background-color: #f8f7f7;
        padding: 30px 0;
    }

    .search-tools::after {
        content: "";
        display: table;
        clear: both;
    }

    .search_menu {
        background-color: #f8f7f7;
        float: left;
        width: 33.3333%;
        height: 100%;
        padding-left: 7%;
        padding-top: 30px;
    }

    .search_menu a {
        display: block;
        color: #0091b3;
        line-height: 28px;
        font-size: 15px;
    }

    .search_menu .search_title {
        font-size: 2rem;
        color: #707070;
        margin-bottom: 10px;
        width: 200px;
    }

    .search_menu .search_subtitle {
        color: #555;
        font-size: 1.6rem;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .search_menu .search_box {
        height: 50px;
        width: 250px;
        font-size: 18px
    }

    .search_menu .search_form {
        display: inline-block;
        position: relative;
        margin-bottom: 20px;
    }

    .search_menu .search_form:after {
        font-family: FontAwesome;
        content: "\f002";
        position: absolute;
        right: 6px;
        top: 13px;
        color: #aaa;
        font-size: 17px;
    }

    .search_bar a.sub_menu {
        margin-left: 12px;
        background-image: url(/wp-content/themes/invest/images/flecha_derecha_celeste.png);
        background-repeat: no-repeat;
        background-size: 11px;
        background-position: 0px 7px;
        padding-left: 14px;
    }

    .tooltip {
        font-size: 1.4rem;
        display: inline-block;
        margin-left: 0.2rem;
        position: relative;
        cursor: pointer;
        opacity: 1 !important;
        color: #707070;
    }

    .tooltip:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        min-width: 15em;
        font-weight: normal;
        line-height: 1.3;
        margin: 0;
        background: #767777;
        color: #fff;
        padding: 15px;
        border-radius: 5px;
        left: 20px;
        top: 0px;
        z-index: 1;
        font-size: .8em;
        text-align: left;
    }

    .control_sub_menu a {
        display: inline;
    }

    .toggle_sub_menu_1,
    .toggle_sub_menu_2,
    .toggle_sub_menu_3,
    .toggle_sub_menu_4,
    .toggle_sub_menu_5 {
        margin-left: 10px;
        color: #0091b3;
        cursor: pointer;
        width: 20px;
        display: inline-block;
    }

    .toggle_sub_menu_1.cerrado,
    .toggle_sub_menu_2.cerrado,
    .toggle_sub_menu_3.cerrado,
    .toggle_sub_menu_4.cerrado,
    .toggle_sub_menu_5.cerrado {
        background-image: url(/wp-content/themes/invest/images/flecha_abajo_celeste.png);
        background-repeat: no-repeat;
        background-size: 15px;
        background-position: 0px 2px;
        user-select: none;
    }

    .toggle_sub_menu_1.abierto,
    .toggle_sub_menu_2.abierto,
    .toggle_sub_menu_3.abierto,
    .toggle_sub_menu_4.abierto,
    .toggle_sub_menu_5.abierto {
        background-image: url("/wp-content/themes/invest/images/flecha_arriba_celeste.png");
        background-repeat: no-repeat;
        background-size: 15px;
        background-position: 0px 2px;
        user-select: none;
    }

    .wrap_sub_menu_1.cerrado,
    .wrap_sub_menu_2.cerrado,
    .wrap_sub_menu_3.cerrado,
    .wrap_sub_menu_4.cerrado,
    .wrap_sub_menu_5.cerrado {
        max-height: 0;
        transition: max-height 0.70s ease-out;
        overflow: hidden;
    }

    .wrap_sub_menu_1.abierto,
    .wrap_sub_menu_2.abierto,
    .wrap_sub_menu_3.abierto,
    .wrap_sub_menu_4.abierto,
    .wrap_sub_menu_5.abierto {
        max-height: unset;
        transition: max-height 0.70s ease-in;
    }

    .boxes-search {
