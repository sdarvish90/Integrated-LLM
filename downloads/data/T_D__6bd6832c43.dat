<div class="newspostheader">


<div class="container">
<p id="breadcrumbs"><span><span><a href="https://www.bloomenergy.com/" data-wpel-link="internal">Home</a></span> » <span><a href="/newsroom" data-wpel-link="internal">Newsroom</a></span> » <span>Onsite Generation Expected to Fully Power 27% of Data Center Facilities by 2030</span></span></p>
<div>
	<h1 class="entry-title">Onsite Generation Expected to Fully Power 27% of Data Center Facilities by 2030</h1>
					
					
	</div>

	<div class="et_post_meta_wrapper">
						
	<div class="post-date">June 17, 2025</div>
				

	</div> <!-- .et_post_meta_wrapper -->



</div> <!-- END INNER -->
</div> <!-- END BLOGPOSTHEADER -->
	<div class="container">
	
	<div id="content-area" class="clearfix">
		
<div id="blog-sidebar">
		

				


<div id="custom_html-6" class="widget_text et_pb_widget widget_custom_html"><div class="textwidget custom-html-widget"><a class="et_pb_button" href="/newsroom" data-wpel-link="internal">See all news</a></div></div><div id="text-7" class="et_pb_widget widget_text"><h4 class="widgettitle">Follow Our Leadership</h4>			<div class="textwidget"><div class="sidebar-block__content">
<div class="profile-block">
<div class="profile-block__image"><img decoding="async" class="alignleft" src="https://www.bloomenergy.com/wp-content/uploads/AmanJoshi_s.jpg" alt="" width="70" height="70" /></div>
<div class="profile-block__info">
<div class="profile-block__name"><a href="https://www.linkedin.com/in/aman-joshi-084b4526/" target="_blank" rel="noopener external noreferrer" data-wpel-link="external">Aman Joshi</a></div>
<div class="profile-block__meta"><span class="profile-block__title">Chief Commercial Officer</span></div>
</div>
</div>
<div class="profile-block">
<div class="profile-block__image"><img decoding="async" class="alignleft" src="https://www.bloomenergy.com/wp-content/uploads/Raviportrait_s.png" alt="" width="70" height="70" /></div>
<div class="profile-block__info">
<div class="profile-block__name"><a href="https://www.linkedin.com/in/ravi-prasher-2458b41/" target="_blank" rel="noopener external noreferrer" data-wpel-link="external">Ravi Prasher</a></div>
<div class="profile-block__meta"><span class="profile-block__title">Chief Technology Officer</span></div>
</div>
</div>
<div class="profile-block">
<div class="profile-block__image"><img decoding="async" class="alignleft" src="https://www.bloomenergy.com/wp-content/uploads/SonjaWilkerson_s.png" alt="" width="70" height="70" /></div>
<div class="profile-block__info">
<div class="profile-block__name"><a href="https://www.linkedin.com/in/sonja-wilkerson-202744/" target="_blank" rel="noopener external noreferrer" data-wpel-link="external">Sonja Wilkerson</a></div>
<div class="profile-block__meta"><span class="profile-block__title">Chief People Officer</span></div>
</div>
</div>
