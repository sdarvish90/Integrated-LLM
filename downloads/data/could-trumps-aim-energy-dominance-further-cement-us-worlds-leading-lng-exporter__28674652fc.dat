iar%3D0%26w%3D1600%26rev%3D2cf023b4e0484c1bb091b9f72dbf7771%26hash%3D72DBDFEBEF6EE62E751AB5DD2221C77E&amp;w=3840&amp;q=75"/><img alt="Generic Hero Banner" loading="lazy" width="390" height="667" decoding="async" data-nimg="1" class="Banner_image__xSQ88 d-lg-none" style="color:transparent" srcSet="/_next/image?url=%2F-%2Fmedia%2Fproject%2Fargusmedia%2Fmainsite%2Fimages%2F14-generic-hero-banners%2Fherobanner_390x620_generic-c.jpg%3Fh%3D620%26iar%3D0%26w%3D390%26rev%3D1f6461bbf1f1417cb9ac37adf5126bb2%26hash%3DD27C33C4A19A3079C7BE43A393C45E0D&amp;w=640&amp;q=75 1x, /_next/image?url=%2F-%2Fmedia%2Fproject%2Fargusmedia%2Fmainsite%2Fimages%2F14-generic-hero-banners%2Fherobanner_390x620_generic-c.jpg%3Fh%3D620%26iar%3D0%26w%3D390%26rev%3D1f6461bbf1f1417cb9ac37adf5126bb2%26hash%3DD27C33C4A19A3079C7BE43A393C45E0D&amp;w=828&amp;q=75 2x" src="/_next/image?url=%2F-%2Fmedia%2Fproject%2Fargusmedia%2Fmainsite%2Fimages%2F14-generic-hero-banners%2Fherobanner_390x620_generic-c.jpg%3Fh%3D620%26iar%3D0%26w%3D390%26rev%3D1f6461bbf1f1417cb9ac37adf5126bb2%26hash%3DD27C33C4A19A3079C7BE43A393C45E0D&amp;w=828&amp;q=75"/><div class="Banner_containerWrapper__wuONJ"><div class="Banner_container__ciSUI container"><div class="Banner_containerInner__toBo5"><div><a class="qa-banner-breadcrumb BannerBreadcrumb_bannerBreadcrumb__hHMz7 h3" href="/en/news-and-insights/market-insight-papers"><svg xmlns="http://www.w3.org/2000/svg" width="8.662" height="13.958"><path fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2" d="m7.662 12.958-6.22-5.979L7.663 1"></path></svg>Market insight papers</a><h1>Could Trump&#x27;s aim at energy dominance further cement the US as the world&#x27;s leading LNG exporter?</h1><div>Download our independent analysis for a comprehensive understanding of the US's role in the upcoming wave of LNG supply.

</div></div></div></div></div></div></div></div><div></div><div class="PageSubnavigation_subnavigation__Fl7hT component small"><div class="PageSubnavigation_subnavigationInner__681o9 component-content"><div class="PageSubnavigation_container__yH3q7 qa-subnavigation-bar"><div class="PageSubnavigation_outer__ocRn_ container"><div class="PageSubnavigation_bar__Cf50a"><a href="#overview" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Overview</a><a href="#paper" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Insight paper</a><a href="#products" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Key products</a><a href="#spotlight" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Spotlight content</a><button type="button" class="PageSubnavigation_showMore__2Z47G cta ">More</button><a href="#paper" class="PageSubnavigation_cta__pnmT7 cta bubble" title="">Download the insight paper</a></div><div class="PageSubnavigation_actionContainer__NCnEo"><div class="PageSubnavigation_hamburgerToggle__NbYkc"><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 27 20"><g transform="translate(-297.5 -54.5)"><line x2="24" transform="translate(299 56)" fill="none" stroke="#1b223d" stroke-linecap="round" stroke-width="3"></line><line x2="24" transform="translate(299 65)" fill="none" stroke="#1b223d" stroke-linecap="round" stroke-width="3"></line><line x2="24" transform="translate(299 73)" fill="none" stroke="#1b223d" stroke-linecap="round" stroke-width="3"></line></g></svg></button></div></div></div><div class="PageSubnavigation_drawer__lxQUi grey " style="left:0px"><div class="container"><div class="PageSubnavigation_drawerInner__Q_bJs"><div class="PageSubnavigation_drawerItems__AwukY"><a href="#overview" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Overview</a><a href="#paper" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Insight paper</a><a href="#products" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Key products</a><a href="#spotlight" class="qa-subnavigation-anchor PageSubnavigation_item__mBuP2 cta bar " title="">Spotlight content</a></div></div></div></div><div id="mobile-subnavigation-trigger" class="PageSubnavigation_mobileCta__n9sU5 container"><a href="#paper" class="PageSubnavigation_cta__pnmT7 cta bubble" title="">Download the insight paper</a></div></div></div></div><div class="component white"><div class="component-content"><div class="container"><ul class="PageTags_meta__5q4bN sub-heading h3"><li class="PageTags_metaItem___eXos">19 February 2025</li><li class="PageTags_metaItem___eXos">Market<!-- -->: <!-- -->Gas &amp; Power, LNG, Gas Freight</li></ul></div></div></div><div class="component component-padding ColumnText_columnText__LkARY  white" id="overview"><div class="component-content"><div class="container"><div class="qa-columntext-intro ColumnText_intro__gigTR row"><div class="col-12 col-lg-9"></div></div><div class="ColumnText_panels__SuTAc row"><div class="qa-columntext-panels col-12 col-lg-6"><div class="qa-columntext-panel-text ColumnText_description__uBODH"><p>Gain in-depth understanding of the US&rsquo; role in the new wave of LNG supply coming later this decade within the context of the Trump administration, including key insights on US domestic gas and LNG freight. Download our independent analysis for free below.</p>
<p>Points explored in this insight include:</p>
<ul>
    <li>Regulatory approvals for new projects under the new Trump administration are set to rise, following Biden&rsquo;s pause on key export approvals in 2024.
    </li>
    <li>In the nearer-term, the US is set to cement itself as the largest global LNG exporter, even though large expansions particularly in Qatar are also set to lift global export capacity.
    </li>
    <li>US gas production may have to rise to supply enough gas to serve the US&rsquo; incoming capacity expansion by the end of the decade.
    </li>
    <li>Loading demand from the new LNG projects could help to rebalance the LNG freight market, where oversupply has caused record-low charter rates so far this year.
    </li>
</ul></div></div><div class="qa-columntext-panels col-12 col-lg-6"><div class="qa-columntext-panel-text ColumnText_description__uBODH"><p style="text-align: center;"><img alt="" src="/-/media/project/argusmedia/mainsite/english/images/news-and-insights/market-insight-papers/could-trumps-aim-energy-dominance.png?h=536&amp;w=500&amp;rev=12783841db284f6e867bbdbe923731b5&amp;hash=D33488EFCD2AFE28644DB81157F6413F" style="width: 500px; height: 536px;" /></p></div></div></div></div></div></div><div class="component component-padding undefined  navy" id="paper"><div class="component-content"><div class="GenericForm_content__axQ2w container"><div class="row"><div class="col-12 col-lg-10 offset-lg-1"><h2 class="qa-genericform-title h1 section-heading">Download the insight paper</h2><div class="qa-genericform-inputs GenericForm_form__LvaqC"><div class="MarketoForm_marketoForm__N0nWd"><form id="mktoForm_38293" class="qa-form-marketo"></form></div></div></div></div></div></div></div><div class="component component-padding grey " id="products"><div class="component-content"><div class="container"><div class="row"><div class="col-12 col-lg-7"><h2 class="section-heading">Related products</h2></div></div><div class="ProductListing_products__Uxsig row"><div class="col-12 col-lg-4"><a class="ProductListing_itemLink__RVSjo white" href="/en/solutions/products/argus-lng-daily"><h3 class="sub-heading h4">Argus LNG Daily</h3><div class="ProductListing_itemDescription__E7NK3">Access the latest LNG spot price assessments, market news and independent analysis.</div><span class="ProductListing_itemCta__NeAHB cta">Find out more</span></a></div><div class="col-12 col-lg-4"><a class="ProductListing_itemLink__RVSjo white" href="/en/solutions/products/argus-global-gas-markets"><h3 class="sub-heading h4">Argus Global Gas Markets</h3><div class="ProductListing_itemDescription__E7NK3">Understand the key dynamics that shape today’s interconnected global gas market.</div><span class="ProductListing_item