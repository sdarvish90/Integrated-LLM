"displayName":"Electricity","fields":{"UniqueIdentifier":{"value":"Electricity"}}},{"id":"fedb027c-c553-4ff5-9e0b-ab7a9e90bf09","url":"/en/data/taxonomy-mappings/news-mapping/emissions","name":"Emissions","displayName":"Emissions","fields":{"UniqueIdentifier":{"value":"Emissions"}}},{"id":"a51b53a8-442c-433f-91e0-a961192c4c5c","url":"/en/data/taxonomy-mappings/news-mapping/biomass","name":"Biomass","displayName":"Biomass","fields":{"UniqueIdentifier":{"value":"Biomass"}}},{"id":"a51955c2-4442-42d7-9ea5-30a248c37391","url":"/en/data/taxonomy-mappings/news-mapping/hydrogen","name":"Hydrogen","displayName":"Hydrogen","fields":{"UniqueIdentifier":{"value":"Hydrogen"}}}]}},{"id":"bbcfb880-287a-41b1-8a83-d34b8c1a77c2","url":"/en/data/taxonomy/commodity/gas-and-power/lng","name":"LNG","displayName":"LNG","fields":{"Title":{"value":"LNG"},"AlternateMapping":[{"id":"a73b741a-f9e5-4fb7-8e62-f1adf6a28fb8","url":"/en/data/taxonomy-mappings/news-mapping/natural-gas/lng","name":"LNG","displayName":"LNG","fields":{"UniqueIdentifier":{"value":"LNG"}}}]}},{"id":"e8533d0d-2e93-41c0-bd86-e672230263df","url":"/en/data/taxonomy/commodity/freight/gas-freight","name":"Gas Freight","displayName":"Gas Freight","fields":{"Title":{"value":"Gas Freight"},"AlternateMapping":[{"id":"0a37d2ac-7716-4cb6-9b97-0700509c1643","url":"/en/data/taxonomy-mappings/news-mapping/freight/lpg-carriers","name":"LPG carriers","displayName":"LPG carriers","fields":{"UniqueIdentifier":{"value":"LPG carriers"}}},{"id":"3e02261a-e632-4867-8714-b34a3a8985e6","url":"/en/data/taxonomy-mappings/news-mapping/freight/lng-carriers","name":"LNG carriers","displayName":"LNG carriers","fields":{}}]}},{"id":"2ae31b7d-1d9d-4daa-a303-e5c487b8910e","url":"/en/data/taxonomy/geographyregion/north-america","name":"North America","displayName":"North America","fields":{"Title":{"value":"North America"},"UniqueIdentifier":{"value":"North America"}}},{"id":"f41ab85b-7889-4178-a739-0a0414241774","url":"/en/data/taxonomy/languages/english","name":"English","displayName":"English","fields":{"Title":{"value":"English"},"UniqueIdentifier":{"value":""}}},{"id":"4316f383-c321-4b14-b504-f648f721fb9c","url":"/en/data/taxonomy/product-type/business-intelligence-reports","name":"Business intelligence reports","displayName":"Business intelligence reports","fields":{"Title":{"value":"Business intelligence reports"}}},{"id":"0786fa82-32c1-4747-bce8-5f24e8f42f0d","url":"/en/data/taxonomy/product-type/price-reports","name":"Price reports","displayName":"Price reports","fields":{"Title":{"value":"Price reports"}}}]},"tagLabel":{"jsonValue":{"value":"Market"}}}}}},{"uid":"cea94418-011c-4bf1-b15c-0fbaa4336a00","componentName":"ColumnText","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Could Trumps aim energy dominance further cement US worlds leading LNG exporter/Page Data/column text","fields":{"data":{"datasource":{"anchorID":{"value":"overview"},"type":"ColumnText","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":""}},"panels":{"results":[{"type":"TextPanel","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":"\u003cp\u003eGain in-depth understanding of the US\u0026rsquo; role in the new wave of LNG supply coming later this decade within the context of the Trump administration, including key insights on US domestic gas and LNG freight. Download our independent analysis for free below.\u003c/p\u003e\n\u003cp\u003ePoints explored in this insight include:\u003c/p\u003e\n\u003cul\u003e\n    \u003cli\u003eRegulatory approvals for new projects under the new Trump administration are set to rise, following Biden\u0026rsquo;s pause on key export approvals in 2024.\n    \u003c/li\u003e\n    \u003cli\u003eIn the nearer-term, the US is set to cement itself as the largest global LNG exporter, even though large expansions particularly in Qatar are also set to lift global export capacity.\n    \u003c/li\u003e\n    \u003cli\u003eUS gas production may have to rise to supply enough gas to serve the US\u0026rsquo; incoming capacity expansion by the end of the decade.\n    \u003c/li\u003e\n    \u003cli\u003eLoading demand from the new LNG projects could help to rebalance the LNG freight market, where oversupply has caused record-low charter rates so far this year.\n    \u003c/li\u003e\n\u003c/ul\u003e"}}},{"type":"TextPanel","title":{"jsonValue":{"value":""}},"description":{"jsonValue":{"value":"\u003cp style=\"text-align: center;\"\u003e\u003cimg alt=\"\" src=\"/-/media/project/argusmedia/mainsite/english/images/news-and-insights/market-insight-papers/could-trumps-aim-energy-dominance.png?h=536\u0026amp;w=500\u0026amp;rev=12783841db284f6e867bbdbe923731b5\u0026amp;hash=D33488EFCD2AFE28644DB81157F6413F\" style=\"width: 500px; height: 536px;\" /\u003e\u003c/p\u003e"}}}]}}}}},{"uid":"b249da7f-dde2-4a33-80ae-54c2204150ef","componentName":"GenericForm","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Could Trumps aim energy dominance further cement US worlds leading LNG exporter/Page Data/form","params":{"Theme":"Navy"},"fields":{"FormId":{"value":"38293"},"FormSubmissionLink":{"value":{"href":""}},"AnchorID":{"value":"paper"},"EnableSiteSearch":{"value":true},"Title":{"value":"Download the insight paper"},"Description":{"value":""}}},{"uid":"2872de22-97ad-4d8b-95f3-bd9779da90b9","componentName":"ProductListing","dataSource":"/sitecore/content/ArgusMedia/MainSite/Home/News and insights/Market insight papers/Could Trumps aim energy dominance further cement US worlds leading LNG exporter/Page Data/products","params":{"Theme":"Grey"},"fields":{"ProductPages":[{"id":"75ff62e8-2769-4e0e-8f50-f37d3358ae09","url":"/en/solutions/products/argus-lng-daily","name":"Argus LNG Daily","displayName":"Argus LNG Daily","fields":{"Type":{"id":"a541adba-8189-4f7b-831f-efe4ac1b21a9","url":"/en/data/listing-types/listingtype/product","name":"Product","displayName":"Product","fields